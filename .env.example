# ===== Segurança do app =====
# Administradora principal: entra com este e-mail + APP_PASSWORD (e pode trocar a senha no painel)
ADMIN_EMAIL=knasck@gmail.com
APP_PASSWORD=troque-esta-senha
# "Entrar com Google": Client ID OAuth do tipo Web (não é segredo). Sem ele, o botão não aparece.
GOOGLE_LOGIN_CLIENT_ID=
# Depois que o Google estiver funcionando, mude para true para aceitar só Google
DISABLE_PASSWORD_LOGIN=false
# Opcional: assina as sessões (se vazio, deriva de APP_PASSWORD + MCP_TOKEN)
SESSION_SECRET=
# Opcional: envio do e-mail de convite via Resend. Sem isso, o painel mostra o link para copiar.
RESEND_API_KEY=
MAIL_FROM=Agente de Tráfego <convites@seudominio.com>
# Token do endpoint MCP /mcp (use um valor longo e aleatório)
MCP_TOKEN=troque-por-um-token-longo
# PIN exigido pela ferramenta MCP "aprovar_acao" (a IA não conhece este valor)
APPROVAL_PIN=1234

# ===== Modo de operação =====
# true = simula tudo, nunca altera contas reais. Só mude para false depois de testar.
DRY_RUN=true

# ===== Tetos (aplicados no código, não só no prompt) =====
MAX_DAILY_BUDGET_BRL=300
MAX_BUDGET_INCREASE_PCT=20
MAX_ACTIVATIONS_PER_DAY=5

# ===== IA do chat web =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ===== Google Ads =====
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# ID da conta MCC (somente números, sem hífen)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Confirme a versão vigente na documentação do Google Ads API
GOOGLE_ADS_API_VERSION=v21

# ===== Meta Ads =====
# Token de longa duração de usuário do sistema (Business Manager)
META_ACCESS_TOKEN=
# Formato act_123456789
META_AD_ACCOUNT_ID=
META_API_VERSION=v23.0

# ===== LinkedIn Ads =====
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=
LINKEDIN_API_VERSION=202510

# ===== Persistência =====
# Pasta do arquivo de fila/auditoria. No Render, aponte para o disco persistente (ex.: /var/data)
DATA_DIR=./data
